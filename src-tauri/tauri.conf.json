{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "电源树编辑器",
  "version": "0.1.0",
  "identifier": "com.whz.visual-editor-for-power-supply-trees-tauri",
  "build": {
    "frontendDist": "../public",
    "beforeBuildCommand": "npm run build:public",
    "beforeDevCommand": "npm run build:public"

  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
	"url": "index.html",
        "title": "电源树编辑器",
        "width": 1280,
        "height": 800
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["rpm"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "shortDescription": "电源供电树可视化编辑工具",
    "longDescription": "支持分区树与连线两种视图的电源树编辑器，可本地保存、导入导出，适用于桌面与安卓横屏。",
    "category": "Utility",
    "publisher": "whz",
    "copyright": "Copyright © 2026 whz MIT"
  }
}
